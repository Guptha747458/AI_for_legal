# LegalLens Backend
# Copy this file to .env and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=sk-antropic-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.2

# Document Processing
MAX_DOCUMENT_CHARS=60000
MAX_CONTEXT_CHARS=35000
MAX_CHUNKS=40

# Demo mode (rule-based offline analysis when no API key is set)
LEGALLENS_DEMO_MODE=true

# Data Directories (resolved relative to server/)
LEGALLENS_DATA_DIR=data

# CORS Origins (for development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

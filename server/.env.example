# LegalLens Backend
# Copy this file to .env and fill in your values

# Groq API
GROQ_API_KEY=gsk_your-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# Document Processing
MAX_DOCUMENT_CHARS=60000
MAX_CONTEXT_CHARS=35000
MAX_CHUNKS=40

# Demo mode (rule-based offline analysis when no API key is set)
LEGALLENS_DEMO_MODE=true

# Data Directories (resolved relative to server/)
LEGALLENS_DATA_DIR=data

# CORS Origins (comma-separated; include the deployed frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
